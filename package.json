{
  "name": "batonhq",
  "version": "0.1.3",
  "description": "Hand a unit of coding work from one AI agent to another — plan on your expensive agent, pass the baton to your cheap one.",
  "type": "module",
  "bin": {
    "baton": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "build:web": "npm run build --prefix web",
    "prepack": "node scripts/prepack.mjs",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:desktop-ui": "npm run build --prefix electron/ui",
    "build:desktop": "npm run build && npm run build --prefix web && npm run build:electron && npm run build:desktop-ui && node config/scripts/stage-payload.mjs",
    "desktop": "npm run build:electron && electron electron/dist/main.js",
    "desktop:dev": "npm run build:electron && BATON_DESKTOP_DEV_URL=http://127.0.0.1:5174 electron electron/dist/main.js",
    "icons": "node config/scripts/build-icons.mjs",
    "pack:mac": "npm run build:desktop && electron-builder --mac --config config/electron-builder.cjs --publish never",
    "pack:win": "npm run build:desktop && electron-builder --win --config config/electron-builder.cjs --publish never"
  },
  "keywords": [
    "ai",
    "agents",
    "claude-code",
    "cursor",
    "handoff",
    "llm",
    "cli",
    "developer-tools"
  ],
  "author": "Rakshan Shetty",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rakshan001/Baton-Multi-Agent-.git"
  },
  "homepage": "https://baton-landing.vercel.app",
  "bugs": {
    "url": "https://github.com/Rakshan001/Baton-Multi-Agent-/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "web/dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "gray-matter": "^4.0.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
