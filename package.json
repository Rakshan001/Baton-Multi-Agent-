{
  "name": "batonhq",
  "version": "0.1.3",
  "description": "Hand a unit of coding work from one AI agent to another — plan on your expensive agent, pass the baton to your cheap one.",
  "type": "module",
  "bin": {
    "baton": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "build:web": "npm run build --prefix web",
    "prepack": "node scripts/prepack.mjs",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "lint:license": "node scripts/license-headers.mjs"
  },
  "keywords": [
    "ai",
    "agents",
    "claude-code",
    "cursor",
    "handoff",
    "llm",
    "cli",
    "developer-tools"
  ],
  "author": "Rakshan Shetty",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rakshan001/Baton-Multi-Agent-.git"
  },
  "homepage": "https://baton-landing.vercel.app",
  "bugs": {
    "url": "https://github.com/Rakshan001/Baton-Multi-Agent-/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "web/dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "gray-matter": "^4.0.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
