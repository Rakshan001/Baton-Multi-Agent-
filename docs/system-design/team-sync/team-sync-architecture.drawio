<?xml version="1.0" encoding="UTF-8"?><mxfile host="baton" modified="2026-09-29" type="device"><diagram name="1 Topology" id="1-Topology"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Team Sync — every device is a coordinator (no single hub)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Admin — MacBook Air&lt;br&gt;OWNER device&lt;br&gt;all 5 repos&lt;br&gt;feed: admin.jsonl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#171717;fontColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="90" width="220" height="90" as="geometry"/></mxCell><mxCell id="c4" value="Dev A — MacBook Pro&lt;br&gt;Backend · repos: server&lt;br&gt;feed: A.jsonl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="330" width="220" height="80" as="geometry"/></mxCell><mxCell id="c5" value="Dev B — Mac mini&lt;br&gt;Web + Backend · repos: web, server&lt;br&gt;feed: B.jsonl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="330" width="240" height="80" as="geometry"/></mxCell><mxCell id="c6" value="Dev C — Mac mini&lt;br&gt;UI (non-coder) · repos: web&lt;br&gt;feed: C.jsonl&lt;br&gt;(offline until 14:00)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#999999;fontColor=#777777;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="330" width="240" height="90" as="geometry"/></mxCell><mxCell id="c7" value="Optional always-on peer&lt;br&gt;(Mac mini --always-on)&lt;br&gt;OWNER #2 · relays 24/7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#171717;fontColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="560" width="240" height="80" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;startArrow=block;fontSize=11;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;startArrow=block;fontSize=11;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;startArrow=block;fontSize=11;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;startArrow=block;fontSize=11;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;startArrow=block;fontSize=11;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;startArrow=block;fontSize=11;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;startArrow=block;fontSize=11;" edge="1" parent="1" source="c7" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;startArrow=block;fontSize=11;" edge="1" parent="1" source="c7" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;startArrow=block;fontSize=11;" edge="1" parent="1" source="c7" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;startArrow=block;fontSize=11;" edge="1" parent="1" source="c3" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="GitHub / git remote&lt;br&gt;(code only — not replicated via Team Sync)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3B82F6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="90" width="280" height="60" as="geometry"/></mxCell><mxCell id="c19" value="git push/pull · gh pr" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;fontSize=11;" edge="1" parent="1" source="c3" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="Every link = mutual TLS between admitted devices (keys admitted by an owner via device.admit).&lt;br&gt;Every device stores ALL feeds → any online peer can bring a returning device up to date.&lt;br&gt;Dashed = currently offline. Discovery: UDP beacon :47077 + peers.json + manual host:port." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1100" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 Device internals" id="2-Device-int"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Inside one device" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="600" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Electron app — Team workspace UI&lt;br&gt;(React · Tailwind · shadcn)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="90" width="320" height="70" as="geometry"/></mxCell><mxCell id="c4" value="Coding agent (Claude Code / Cursor /&lt;br&gt;Antigravity / OpenCode) — separate IDE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3B82F6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="260" width="320" height="70" as="geometry"/></mxCell><mxCell id="c5" value="baton daemon (zero-dep Node)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#171717;fontColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="70" width="560" height="40" as="geometry"/></mxCell><mxCell id="c6" value="HTTP API + SSE (loopback only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="130" width="250" height="50" as="geometry"/></mxCell><mxCell id="c7" value="MCP server&lt;br&gt;my_tasks · take_task · complete_task&lt;br&gt;(templated answers, no free text)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="260" width="250" height="80" as="geometry"/></mxCell><mxCell id="c8" value="fold.ts — pure state&lt;br&gt;sort by (lamport, device, seq)&lt;br&gt;+ authority rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="130" width="240" height="80" as="geometry"/></mxCell><mxCell id="c9" value="feed.ts — append · sign (Ed25519)&lt;br&gt;verify · hash chain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="240" width="240" height="60" as="geometry"/></mxCell><mxCell id="c10" value="sync.ts — mTLS peer links&lt;br&gt;HELLO / EVENTS / LIVE / BLOB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="330" width="240" height="60" as="geometry"/></mxCell><mxCell id="c11" value="discovery.ts — dgram beacon&lt;br&gt;+ peers.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="420" width="240" height="50" as="geometry"/></mxCell><mxCell id="c12" value="~/.baton/team/&lt;teamId&gt;/&lt;br&gt;feeds/*.jsonl · blobs/&lt;sha256&gt;&lt;br&gt;device.key (0600) · tls-cert.pem&lt;br&gt;state.cache.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#F59E0B;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="540" y="420" width="250" height="90" as="geometry"/></mxCell><mxCell id="c13" value="Shared task engine&lt;br&gt;(pipeline store + member field)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="540" width="250" height="50" as="geometry"/></mxCell><mxCell id="c14" value="Other devices" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3B82F6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="330" width="160" height="60" as="geometry"/></mxCell><mxCell id="c15" value="loopback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="MCP (stdio)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="read state" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="read state" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="write event (user action)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="c6" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="new event" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="c9" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="verified remote events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="c10" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="gossip new events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="mTLS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;startArrow=block;fontSize=11;" edge="1" parent="1" source="c10" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="candidate peers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="c11" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="append" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="c9" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="project into" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="c8" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 Replication protocol" id="3-Replicatio"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Sync between two admitted devices" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="700" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Device A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#171717;fontColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="80" width="160" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Device B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#171717;fontColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="80" width="160" height="40" as="geometry"/></mxCell><mxCell id="c5" value="1  mTLS handshake — cert must match a key admitted by device.admit (pinned via ca:[peerCert])" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="140" width="920" height="44" as="geometry"/></mxCell><mxCell id="c6" value="2  HELLO {team, vector:{admin:47, A:12, B:30, C:0}}  ⇄  HELLO {…}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="200" width="920" height="44" as="geometry"/></mxCell><mxCell id="c7" value="3  Each side diffs vectors → sends missing events per feed in seq order (≤256 KB frames)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="260" width="920" height="44" as="geometry"/></mxCell><mxCell id="c8" value="4  Receiver verifies: signature · seq = last+1 · prev = hash(last) → append → refold state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="320" width="920" height="44" as="geometry"/></mxCell><mxCell id="c9" value="5  LIVE: new/received events gossiped to all connected peers; duplicates dropped by (device, seq)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="380" width="920" height="44" as="geometry"/></mxCell><mxCell id="c10" value="6  BLOB GET &lt;sha256&gt; on demand (attachments, skill bundles) → verify hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="440" width="920" height="44" as="geometry"/></mxCell><mxCell id="c11" value="Fork = two events with same (device, seq) → keep first, raise device.fork.detected → owner revokes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#F59E0B;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="160" y="520" width="920" height="44" as="geometry"/></mxCell><mxCell id="c12" value="Convergence: state = fold(sort(events)). Same event SET ⇒ identical state on every device, regardless of arrival order.&lt;br&gt;Wall-clock ts is display-only; ordering uses Lamport clocks." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="600" width="920" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4 Admin-offline scenario" id="4-Admin-offl"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Admin assigns at 09:30, leaves at 12:00 — C joins at 14:10 and still gets the task" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Admin (owner)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#171717;fontColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="140" height="50" as="geometry"/></mxCell><mxCell id="c4" value="Dev A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="140" height="50" as="geometry"/></mxCell><mxCell id="c5" value="Dev B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="140" height="50" as="geometry"/></mxCell><mxCell id="c6" value="Dev C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="140" height="50" as="geometry"/></mxCell><mxCell id="c7" value="09:30  task.upsert ×3&lt;br&gt;task.assign → A, B, C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#171717;fontColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="100" width="240" height="60" as="geometry"/></mxCell><mxCell id="c8" value="09:30  receives live" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="260" width="240" height="60" as="geometry"/></mxCell><mxCell id="c9" value="09:30  receives live" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="420" width="240" height="60" as="geometry"/></mxCell><mxCell id="c10" value="offline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#999999;fontColor=#777777;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="580" width="240" height="60" as="geometry"/></mxCell><mxCell id="c11" value="12:00  closes laptop&lt;br&gt;(shown: offline, last seen 12:00)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#999999;fontColor=#777777;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="100" width="240" height="60" as="geometry"/></mxCell><mxCell id="c12" value="works on task-12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="260" width="240" height="60" as="geometry"/></mxCell><mxCell id="c13" value="works on task-13" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="420" width="240" height="60" as="geometry"/></mxCell><mxCell id="c14" value="14:10  starts Baton → beacon finds A, B&lt;br&gt;HELLO: missing admin#41–47" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="580" width="240" height="60" as="geometry"/></mxCell><mxCell id="c15" value="14:10  streams admin#41–47 + blobs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="260" width="240" height="60" as="geometry"/></mxCell><mxCell id="c16" value="14:10  fold ⇒ task-14 assigned to C&lt;br&gt;OS notification + brief + attachments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="580" width="240" height="60" as="geometry"/></mxCell><mxCell id="c17" value="14:12  task.transition active → gossiped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="580" width="240" height="60" as="geometry"/></mxCell><mxCell id="c18" value="receives C#1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="260" width="240" height="60" as="geometry"/></mxCell><mxCell id="c19" value="receives C#1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="420" width="240" height="60" as="geometry"/></mxCell><mxCell id="c20" value="next day: reconnects → syncs everything" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="100" width="240" height="60" as="geometry"/></mxCell><mxCell id="c21" value="admin's signed events relayed by A" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="c15" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="gossip" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;fontSize=11;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="No owner online ⇒ still works: sync, take task, transitions, push, skills/attachments already offered.&lt;br&gt;Needs an owner device: admit new devices, assign, review decisions." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1200" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="5 Task lifecycle" id="5-Task-lifec"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Assign → work → review → push → merge (who may write each event)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c3" value="task.upsert + task.assign&lt;br&gt;[owner]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#171717;fontColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="220" height="70" as="geometry"/></mxCell><mxCell id="c4" value="Member notified&lt;br&gt;(OS notification · Inbox)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="120" width="220" height="70" as="geometry"/></mxCell><mxCell id="c5" value="Copy prompt → paste into own agent&lt;br&gt;or agent: my_tasks/take_task" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="120" width="220" height="70" as="geometry"/></mxCell><mxCell id="c6" value="task.transition active&lt;br&gt;[assignee]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="120" width="220" height="70" as="geometry"/></mxCell><mxCell id="c7" value="Agent works in member's IDE&lt;br&gt;(skill offers installed locally, guard: advise/enforce)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="120" width="220" height="70" as="geometry"/></mxCell><mxCell id="c8" value="git push (agent or human)&lt;br&gt;→ git.pushed intent=track [device]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="300" width="220" height="70" as="geometry"/></mxCell><mxCell id="c9" value="Mark ready → task.transition review&lt;br&gt;[assignee]  · gh pr create" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="300" width="220" height="70" as="geometry"/></mxCell><mxCell id="c10" value="Owner notified · reviews diff / PR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="300" width="220" height="70" as="geometry"/></mxCell><mxCell id="c11" value="review.decide&lt;br&gt;[owner]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#171717;fontColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="300" width="220" height="70" as="geometry"/></mxCell><mxCell id="c12" value="changes → back to member&lt;br&gt;(text.add note, human-only)&lt;br&gt;Copy prompt again" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="480" width="220" height="70" as="geometry"/></mxCell><mxCell id="c13" value="approved → push.request [owner]&lt;br&gt;member clicks Push now (local)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#171717;fontColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="480" width="220" height="70" as="geometry"/></mxCell><mxCell id="c14" value="owner merges (gh pr merge,&lt;br&gt;human-confirmed) → git.default.advanced" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="480" width="220" height="70" as="geometry"/></mxCell><mxCell id="c15" value="Everyone notified → Copy prompt&lt;br&gt;'pull latest' → task done" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="480" width="220" height="70" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="rework loop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;fontSize=11;" edge="1" parent="1" source="c12" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="approved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="6 RBAC" id="6-RBAC"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="RBAC — roles per project (Custodian is team-wide) · authority checked at the author's deps" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Custodian&lt;br&gt;admit/revoke devices · grant roles&lt;br&gt;≥2 devices or paper recovery key&lt;br&gt;quorum for custodian changes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#171717;fontColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="270" height="110" as="geometry"/></mxCell><mxCell id="c4" value="Lead (per project)&lt;br&gt;create/assign/prioritize/remind&lt;br&gt;review · merge (native confirm)&lt;br&gt;offer skills · define projects" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#171717;fontColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="90" width="270" height="110" as="geometry"/></mxCell><mxCell id="c5" value="Developer (per project)&lt;br&gt;ack/take/transition own tasks&lt;br&gt;push · attach own · comment own threads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="90" width="270" height="110" as="geometry"/></mxCell><mxCell id="c6" value="Designer (per project)&lt;br&gt;like Developer, guard=enforce forced&lt;br&gt;skill accept needs Lead co-sign&lt;br&gt;Send-to-agent only Lead comments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="90" width="270" height="110" as="geometry"/></mxCell><mxCell id="c7" value="Viewer&lt;br&gt;read only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="90" width="200" height="110" as="geometry"/></mxCell><mxCell id="c8" value="Relay (Mac mini)&lt;br&gt;store &amp; forward only&lt;br&gt;ciphertext for encrypted bodies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#999999;fontColor=#777777;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="230" width="200" height="110" as="geometry"/></mxCell><mxCell id="c9" value="grants ≤ below" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="grants ≤ below" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="Strong removal: device.revoke{cutoffSeq} voids later events + everything they authorised&lt;br&gt;Mutual custodian revoke → both apply → recovery mode (only recovery key restores)&lt;br&gt;Lamport = max(deps)+1 (derived) → no backdating / inflation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#F59E0B;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="1100" height="80" as="geometry"/></mxCell><mxCell id="c14" value="Local boundary: loopback ≠ trust. Irreversible actions (assign, review, merge, Push now, accept skill, admit/revoke)&lt;br&gt;= renderer → Electron main native dialog → main signs with Keychain key → daemon with per-launch IPC capability.&lt;br&gt;Agents (MCP / curl) get 403." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#F59E0B;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="1100" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="7 Project identity" id="7-Project-id"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Same repo, different folders → one project key (never a folder name)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c3" value="project.define&lt;br&gt;key = prj_7f3a (random)&lt;br&gt;name = API&lt;br&gt;remotes = [github.com/acme/api]&lt;br&gt;rootCommits = [c0ffee…]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#171717;fontColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="80" width="300" height="110" as="geometry"/></mxCell><mxCell id="c4" value="Owner hub root ~/work/acme/&lt;br&gt;├ web ├ api ├ mobile ├ admin ├ infra&lt;br&gt;api → prj_7f3a" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="320" height="100" as="geometry"/></mxCell><mxCell id="c5" value="project-map.json" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c6" value="Dev A ~/code/acme-api (single repo)&lt;br&gt;remote git@github.com:acme/api.git&lt;br&gt;→ normalized github.com/acme/api → prj_7f3a" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="300" width="320" height="100" as="geometry"/></mxCell><mxCell id="c7" value="project-map.json" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="Dev B ~/projects/ (2 repos)&lt;br&gt;website/ backend/&lt;br&gt;backend remote https://github.com/acme/api → prj_7f3a" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="300" width="320" height="100" as="geometry"/></mxCell><mxCell id="c9" value="project-map.json" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="c3" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="Dev C ~/web (single repo)&lt;br&gt;no api clone → inventory lacks prj_7f3a&lt;br&gt;→ assign dialog warns" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#999999;fontColor=#777777;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="300" width="320" height="100" as="geometry"/></mxCell><mxCell id="c11" value="project-map.json" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;fontSize=11;" edge="1" parent="1" source="c3" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="Match order: any remote (normalized, incl. upstream/fork) → root commit (human confirm) → 'Locate repo…'&lt;br&gt;Excluded: .baton/wt/* worktrees · duplicate clones → user picks primary · renamed remote → project.alias · monorepo → subpath&lt;br&gt;Each device publishes device.inventory{projectKeys} so leads see who really has which repo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#F59E0B;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="460" width="1400" height="80" as="geometry"/></mxCell><mxCell id="c13" value="Feature group: 'Admin table' → child task web (Dev C) + child task api (Dev B), linked by dependsOn&lt;br&gt;Branches: baton/&lt;member&gt;/&lt;slug&gt;-&lt;id6&gt; per child" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="570" width="1400" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>